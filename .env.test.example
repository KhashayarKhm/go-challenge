# Copy to .env.test.local: cp .env.test.example .env.test.local
# Loaded for every `make test` / `make test-integration` run. Real environment variables take precedence.

# ClickHouse integration tests (make test-integration). Use a dedicated database: the tests empty
# its tables. Prepare it first (see README).
CLICKHOUSE_DSN=clickhouse://default:clickhouse@localhost:9000/es_test
