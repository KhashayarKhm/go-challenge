# Copy to .env for local runs: cp .env.example .env
# Real environment variables take precedence over values in .env.
# Defaults match docker-compose.yml.

# --- Shared (cmd/ingest, cmd/api, cmd/migrate) ---
CLICKHOUSE_DSN=clickhouse://default:clickhouse@localhost:9000/es_db

# --- Ingestion worker (cmd/ingest) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=estimation.segments
# Empty: estimation-service-<UTC start time, YYYY-MM-dd HH:mm>. Set a unique value per replica.
RABBITMQ_CONSUMER_TAG=
# Rows per ClickHouse insert; also the RabbitMQ prefetch (max 65535).
BATCH_SIZE=10000
FLUSH_INTERVAL=10s

# --- gRPC API (cmd/api) ---
GRPC_ADDR=:9090

# --- Profiling (both) ---
PPROF_ENABLED=false
# Defaults differ per process (ingest localhost:6060, api localhost:6061). Setting it here applies
# to both processes, so leave it unset when running both on one host.
# PPROF_ADDR=localhost:6060
